#!/bin/bash
# The glue (tree/ and scripts/, rendered for ImageId=), build-time knobs
# (plain mkosi settings, see mkosi.local.conf.example), then the glue's
# postinst.

set -e

if [ -z "$IMAGE_VERSION" ]; then
	echo "No ImageVersion set; build with: mkosi -B build" >&2
	exit 1
fi

"$SRCDIR/scripts/install-glue" "$SRCDIR" /

mkosi_setting() {
	python3 -c '
import json, os, sys
v = json.load(open(os.environ["MKOSI_CONFIG"])).get(sys.argv[1])
print(" ".join(v) if isinstance(v, list) else (v or ""))' "$1"
}

# The image's mirror: Mirror= (else Arch's geo mirror), kept in the image
# for finalize, which writes the mirrorlist on every build and update.
mirror="$(mkosi_setting Mirror)"
echo "${mirror:-https://geo.mirror.pkgbuild.com}" > "/usr/lib/$IMAGE_ID/mirror"

# KernelCommandLine= is otherwise unused (Bootable=no). Kept in the image so
# in-box UKI rebuilds (the update) reuse it.
mkosi_setting KernelCommandLine > "/usr/lib/$IMAGE_ID/cmdline"

"/usr/lib/$IMAGE_ID/postinst" "$OUTPUTDIR/${IMAGE_ID}_${IMAGE_VERSION}.efi"
