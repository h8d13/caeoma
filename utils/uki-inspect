#!/usr/bin/env python3
# What a UKI will boot: its sections, os-release (which names the erofs the
# initrd mounts), cmdline and kernel version, and the os-release files
# inside its initrd. Needs pefile, zstd and cpio: run it in the tools tree,
#
#   mkosi box -- utils/uki-inspect mkosi.output/<id>_<ver>.efi [--files]
#
# --files also lists every file in the initrd.

import os
import subprocess
import sys
import tempfile

import pefile


def section_data(section):
	# Without the zero padding up to the raw section size.
	return section.get_data()[:section.Misc_VirtualSize]


NEWC = b"070701"
ZSTD = b"\x28\xb5\x2f\xfd"


def newc_end(data, pos):
	# End of the uncompressed newc archive at pos, or None if it is not one.
	while data.startswith(NEWC, pos):
		try:
			filesize = int(data[pos + 54:pos + 62], 16)
			namesize = int(data[pos + 94:pos + 102], 16)
		except ValueError:
			return None
		name = data[pos + 110:pos + 110 + namesize - 1]
		pos = (pos + 110 + namesize + 3) & ~3
		pos = (pos + filesize + 3) & ~3
		if name == b"TRAILER!!!":
			return pos
	return None


def tail_start(data, pos):
	# Where the uncompressed archives after a zstd one at pos begin: the
	# first NEWC that parses as archives up to the (zero padded) end.
	cand = data.find(NEWC, pos)
	while cand >= 0:
		end = cand
		while end is not None and data.startswith(NEWC, end):
			end = newc_end(data, end)
			if end is not None:
				while end < len(data) and data[end] == 0:
					end += 1
		if end == len(data):
			return cand
		cand = data.find(NEWC, cand + 1)
	return len(data)


def initrd_archives(initrd):
	# The kernel unpacks them in order, later files win. mkinitcpio: an
	# early cpio and the zstd main image; build-uki adds os-release after.
	archives, pos = [], 0
	while pos < len(initrd):
		if initrd[pos] == 0:
			pos += 1
		elif initrd.startswith(NEWC, pos):
			end = newc_end(initrd, pos)
			if end is None:
				sys.exit(f"bad cpio in .initrd at {pos}")
			archives.append(initrd[pos:end])
			pos = end
		elif initrd.startswith(ZSTD, pos):
			end = tail_start(initrd, pos)
			archives.append(subprocess.run(["zstd", "-dc"],
				input=initrd[pos:end].rstrip(b"\0"),
				capture_output=True, check=True).stdout)
			pos = end
		else:
			sys.exit(f"unknown archive in .initrd at {pos}")
	return archives


def main():
	if len(sys.argv) < 2:
		sys.exit(__doc__ or "usage: uki-inspect <uki.efi> [--files]")
	uki = sys.argv[1]
	list_files = "--files" in sys.argv[2:]

	pe = pefile.PE(uki, fast_load=True)
	sections = {s.Name.rstrip(b"\0").decode(): s for s in pe.sections}

	print("=== sections")
	for name, s in sections.items():
		print(f"{name:10} {s.Misc_VirtualSize:>12} bytes")
	for name in (".osrel", ".cmdline", ".uname"):
		if name in sections:
			print(f"=== {name}")
			print(section_data(sections[name]).decode().rstrip("\0\n"))

	archives = initrd_archives(section_data(sections[".initrd"]))
	wanted = ["etc/initrd-release", "etc/os-release",
		"usr/lib/os-release", "etc/hostname"]
	with tempfile.TemporaryDirectory() as root:
		for cpio in archives:
			subprocess.run(["cpio", "-idmu", "--quiet", "-D", root,
				*wanted], input=cpio, check=False)
		for path in wanted:
			full = os.path.join(root, path)
			if os.path.islink(full):
				print(f"=== initrd:{path} -> {os.readlink(full)}")
			elif os.path.exists(full):
				print(f"=== initrd:{path}")
				print(open(full).read().rstrip("\n"))
			else:
				print(f"=== initrd:{path} (absent)")

	if list_files:
		for i, cpio in enumerate(archives):
			print(f"=== initrd files (archive {i + 1}/{len(archives)})")
			print(subprocess.run(["cpio", "-t", "--quiet"], input=cpio,
				capture_output=True, check=True).stdout.decode()
				.rstrip("\n"))


main()
