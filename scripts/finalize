#!/bin/bash
# Freeze the tree: vendor config moves under /usr; /etc on the installed
# system is an overlay of factory /etc with only local changes in its upper.
# Run inside the tree, by the mkosi build and by the in-box update (on a
# tree that was finalized before), so every step must be idempotent, and
# touch only what changed: in the update any write, even of identical
# bytes, is copied up into the overlay and lands in the image delta.
# Usage: IMAGE_ID=... finalize

set -e

: "${IMAGE_ID:?}"

# Image state rules (the state script): read once, before anything
# changes, so a broken rule file stops the build here.
rules="$("/usr/lib/$IMAGE_ID/state")"

# carry: state describing the image moves into /usr/lib/sysimage (e.g.
# pacman's installed-package DB; DBPath stays /var/lib/pacman for the
# writable lock and repo indexes). Only a fresh build has the real thing
# here: the update binds the sysimage copy over it in the tree, and the
# leftover mount point goes with the drops below.
while read -r verb path; do
	[ "$verb" = carry ] || continue
	target="/usr/lib/sysimage/${path#/var/lib/}"
	if [ -e "$target" ]; then
		# The impermanence pitfall: binding over real content hides it.
		if [ -d "$path" ] && [ ! -L "$path" ] \
			&& [ -n "$(find "$path" -mindepth 1 -print -quit)" ]; then
			echo "carry $path: both $path and $target have content" >&2
			exit 1
		fi
		continue
	fi
	if [ -e "$path" ]; then
		mkdir --parents "$(dirname "$target")"
		mv --no-target-directory "$path" "$target"
	fi
done <<< "$rules"
# The build's keyring holds a private lsign key: never ship it.
rm --recursive --force /etc/pacman.d/gnupg

# The image's credentials (tree/usr/lib/credstore: first boot settings,
# root password), root-only. The glue copies them as git has them (0644):
# set here, only where they differ (a chmod is a copy-up in the update).
if [ -d /usr/lib/credstore ]; then
	[ "$(stat --format=%a /usr/lib/credstore)" = 700 ] \
		|| chmod 0700 /usr/lib/credstore
	find /usr/lib/credstore -type f ! -perm 0600 -exec chmod 0600 {} +
fi

# PAM falls back to /usr/lib/pam.d per service.
if [ -d /etc/pam.d ]; then
	find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
	rmdir /etc/pam.d
fi

# Apply presets: enablement links stay in /etc/systemd/{system,user} and
# ship in factory /etc, the box's /etc lower. A new image's enablement
# reaches the box; a local systemctl disable is a whiteout in the upper
# and outlives updates. First boot's preset-all finds them in place.
systemctl preset-all
systemctl preset-all --global

# pacman-mirrorlist ships every server commented out: the image's mirror
# (/usr/lib/<id>/mirror) is written again on every update, so a new
# pacman-mirrorlist leaves no .pacnew of our own edit behind. Only written
# when it differs (else a copy-up in the delta). Override on the box by
# editing /etc/pacman.d/mirrorlist.
mirrorlist=/etc/pacman.d/mirrorlist
echo "Server = $(cat "/usr/lib/$IMAGE_ID/mirror")/\$repo/os/\$arch" \
	> "$mirrorlist.new"
if cmp --quiet "$mirrorlist.new" "$mirrorlist"; then
	rm "$mirrorlist.new"
else
	mv "$mirrorlist.new" "$mirrorlist"
fi
rm --force "$mirrorlist.pacnew"

# A .pacnew: the package's default changed under a file the image edits
# (a .pacsave: a removed package's edited file). Shipped like any file,
# and named here, where the update shows it, rather than found years on;
# once: those factory already has came with an earlier version.
(cd /etc && find . \( -name '*.pacnew' -o -name '*.pacsave' \) -printf '%P\n') \
	| while IFS= read -r rel; do
		[ -e "/usr/share/factory/etc/$rel" ] || echo "/etc/$rel: merge it" \
			"into the image (glue tree/) or on the box"
	done

# Factory /etc (the box's /etc overlay lower) mirrors /etc minus machine
# state (made at boot by sysusers, firstboot, ldconfig, resolved) and
# resolv.conf (a bind mount in builds).
# Synced rather than rebuilt: unchanged entries are never rewritten.
factory=/usr/share/factory/etc

is_machine_state() {
	case "$1" in
	.pwd.lock|passwd|passwd-|shadow|shadow-|group|group-|gshadow|gshadow-) ;;
	machine-id|hostname|localtime|locale.conf|vconsole.conf|crypttab) ;;
	resolv.conf|ld.so.cache|pam.d|pam.d/*|pacman.d/gnupg|pacman.d/gnupg/*) ;;
	# The box's own config (local state.d, glue URL).
	"$IMAGE_ID"|"$IMAGE_ID"/*) ;;
	*) return 1 ;;
	esac
}

mkdir --parents "$factory"
# Gone from /etc, or machine state: drop (deepest first).
(cd "$factory" && find . -mindepth 1 -depth -printf '%P\n') \
	| while IFS= read -r rel; do
		if is_machine_state "$rel" \
			|| { [ ! -e "/etc/$rel" ] && [ ! -L "/etc/$rel" ]; }; then
			rm --recursive --force "${factory:?}/$rel"
		fi
	done
# Tree $1 as file $2, one sorted line per entry: path, type,
# mode:uid:gid, link target, content hash of regular files. Two finds and
# a batched hash instead of a stat/readlink/cmp fork pair per entry. Plain
# files, no <(): a failure stops here instead of syncing nothing.
tree_manifest() {
	local tab=$'\t'
	(cd "$1" && find . -mindepth 1 -printf '%P\t%y\t%m:%U:%G\t%l\n') \
		| LC_ALL=C sort -t "$tab" -k 1,1 > "$2.meta"
	(cd "$1" && find . -mindepth 1 -type f -printf '%P\0' \
		| xargs -0 --no-run-if-empty sha256sum) \
		| sed 's/^\([0-9a-f]*\)  \(.*\)$/\2\t\1/' \
		| LC_ALL=C sort -t "$tab" -k 1,1 > "$2.hash"
	LC_ALL=C join -t "$tab" -a 1 "$2.meta" "$2.hash" > "$2"
}

# New or changed: copy, keeping type, mode, owner and xattrs. Only entries
# whose manifest line differs are looked at (the checks below still decide).
manifests="$(mktemp --directory)"
tree_manifest /etc "$manifests/etc"
tree_manifest "$factory" "$manifests/factory"
LC_ALL=C comm -23 "$manifests/etc" "$manifests/factory" > "$manifests/changed"
rm --recursive --force "$manifests/"*.meta "$manifests/"*.hash
cut --fields=1 "$manifests/changed" | while IFS= read -r rel; do
	is_machine_state "$rel" && continue
	src="/etc/$rel"
	dst="$factory/$rel"
	if [ -d "$src" ] && [ ! -L "$src" ]; then
		if [ ! -d "$dst" ] || [ -L "$dst" ]; then
			rm --recursive --force "$dst"
			mkdir "$dst"
		fi
		# Even a no-op chmod is a metadata write, hence a copy-up.
		if [ "$(stat --format=%a:%u:%g "$src")" != \
			"$(stat --format=%a:%u:%g "$dst")" ]; then
			chmod --reference="$src" "$dst"
			chown --reference="$src" "$dst"
		fi
		continue
	fi
	if [ -L "$src" ] && [ -L "$dst" ] \
		&& [ "$(readlink "$src")" = "$(readlink "$dst")" ]; then
		continue
	fi
	if [ -f "$src" ] && [ ! -L "$src" ] && [ -f "$dst" ] && [ ! -L "$dst" ] \
		&& cmp --quiet "$src" "$dst" \
		&& [ "$(stat --format=%a:%u:%g "$src")" = \
			"$(stat --format=%a:%u:%g "$dst")" ]; then
		continue
	fi
	rm --recursive --force "$dst"
	cp --archive --no-target-directory "$src" "$dst"
done
rm --recursive --force "$manifests"

# No UKI inside the image: each would be appended (~70M) to every delta.
# The mkosi build adds one to the factory ESP only to seed a fresh disk.
rm --force /usr/share/factory/boot/EFI/Linux/*.efi

# /boot is the ESP mountpoint; kernel and initrd only live in the UKI.
mkdir --parents /boot
find /boot -mindepth 1 -delete

# drop: never in the image (vendor: the image's /var, as ParticleOS drops
# it by shipping /usr only). Every match of every rule is checked before
# anything is removed, so a bad rule fails the build or update untouched.
# A mount belongs to the builder (mkosi binds its scratch dir on /var/tmp):
# a mount point itself is skipped, anything containing one refused.
# Nothing at, above or inside a protected tree; nothing at or above a core
# directory, nor directly in /usr, /usr/bin, /usr/lib (libc, the loader and
# the binaries are those entries): a rule must not make the image unbootable.
protected_trees=(/usr/lib/systemd /usr/lib/modules "/usr/lib/$IMAGE_ID"
	/usr/lib/sysimage /usr/lib/os-release /usr/share/factory /boot)
core_dirs=(/usr /usr/bin /usr/lib /etc)
whole_dirs=(/usr /usr/bin /usr/lib)

# Fails with the reason when <entry> must not be dropped.
check_drop() {
	local entry="$1" p
	for p in "${protected_trees[@]}" "${core_dirs[@]}"; do
		case "$p/" in
		"$entry/"*) echo "drop $entry: would remove $p" >&2; return 1 ;;
		esac
	done
	for p in "${protected_trees[@]}"; do
		case "$entry" in
		"$p/"*) echo "drop $entry: inside protected $p" >&2; return 1 ;;
		esac
	done
	for p in "${whole_dirs[@]}"; do
		if [ "$(dirname "$entry")" = "$p" ]; then
			echo "drop $entry: an entry of $p itself" >&2
			return 1
		fi
	done
	if findmnt --list --noheadings --output TARGET | grep --quiet "^$entry/"; then
		echo "drop $entry: something is mounted below it" >&2
		return 1
	fi
}

drops=()
shopt -s dotglob nullglob
while read -r verb pattern; do
	[ "$verb" = drop ] || continue
	# Unquoted on purpose: the pattern is a glob.
	for entry in $pattern; do
		# mountpoint follows links: /var/run -> ../run is a mount.
		if [ ! -L "$entry" ] && mountpoint --quiet "$entry"; then
			continue
		fi
		check_drop "$entry" || exit 1
		drops+=("$entry")
	done
done <<< "$rules"
shopt -u dotglob nullglob
for entry in "${drops[@]}"; do
	rm --recursive --force "$entry"
done
