#!/bin/bash
# Build the UKI: kernel + mkinitcpio initrd + cmdline + os-release.
# Extra cmdline comes from the image (/usr/lib/<id>/cmdline, written at
# build time from KernelCommandLine=) so in-box rebuilds keep it.
# Usage: IMAGE_ID=... build-uki <output.efi>

set -e

out="$1"
: "${IMAGE_ID:?}"
cmdline="/usr/lib/$IMAGE_ID/cmdline"
extra=""
[ ! -f "$cmdline" ] || extra="$(cat "$cmdline")"
modules=(/usr/lib/modules/*)
kver="$(basename "${modules[-1]}")"
work="$(mktemp --directory)"

cat > "$work/mkinitcpio.conf" <<- EOF
	MODULES=(erofs loop btrfs)
	BINARIES=()
	FILES=()
	HOOKS=(base systemd modconf kms keyboard block filesystems $IMAGE_ID)
EOF

mkinitcpio --config "$work/mkinitcpio.conf" --generate "$work/initrd" \
	--kernel "$kver"

# No root=: gpt-auto finds the root partition, @system is mounted as /.
ukify build \
	--linux "/usr/lib/modules/$kver/vmlinuz" \
	--initrd "$work/initrd" \
	--cmdline "rw rootflags=subvol=@system,compress=zstd${extra:+ $extra}" \
	--output "$out"

rm --recursive --force "$work"
