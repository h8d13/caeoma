#!/bin/bash
# <id>-update: derive the next image from the running one and stage it.
#
#   <id>-update [--squash] [pacman args]
#                                 default -Syu; e.g. -Syu foo bar
#                                 --squash: full image instead of a delta
#   <id>-update glue [url]        fetch a repo tarball (.tar.gz); its
#                                 scripts/ and tree/ go into every
#                                 following image. URL kept in /etc/<id>.
#
# The running erofs (whole tree) is the lower layer of an overlay; pacman
# runs in it like arch-chroot does (host /proc /sys /dev /run, so hooks see
# real hardware); finalize re-freezes the tree. The next erofs is a reflink
# copy of the running one with only the upper dir appended (btrfs shares the
# rest), or with --squash (and as fallback when that fails) the whole
# merged view, dropping data that later appends left dead. The image is
# renamed into /system, the UKI copied to the ESP with boot counting; the
# newest $keep versions (plus the running one) stay. Not systemd-sysupdate:
# it writes NOCOW files, which btrfs cannot reflink with, so every image
# would cost its full size.

set -eu

. /usr/lib/os-release
# The glue scripts (state, install-glue, postinst, finalize) take it.
export IMAGE_ID

state="/var/lib/$IMAGE_ID"
glue_url_file="/etc/$IMAGE_ID/glue-url"
# Same mount as /system: FICLONE refuses to reflink across mounts.
work="/system/.$IMAGE_ID-update"
keep=3

usage() {
	sed -n "2,10{s/^# \{0,1\}//;s/<id>/$IMAGE_ID/g;p}" "$0"
}

fetch_glue() {
	local url="${1:-}"
	if [ -z "$url" ]; then
		url="$(cat "$glue_url_file")"
	fi
	mkdir --parents "$(dirname "$glue_url_file")" "$state"
	echo "$url" > "$glue_url_file"

	local tmp
	tmp="$(mktemp --directory)"
	curl --fail --location "$url" \
		| tar --extract --gzip --strip-components=1 --directory "$tmp"
	rm --recursive --force "$state/glue"
	mkdir "$state/glue"
	cp --archive "$tmp/scripts" "$tmp/tree" "$state/glue/"
	rm --recursive --force "$tmp"
	echo "Glue from $url in $state/glue; used by the next update."
}

# Unmounting in reverse mount order; safe to call at any point.
cleanup() {
	local m
	for m in "etc/$IMAGE_ID" "${carried[@]}" var/lib/pacman/sync \
		var/cache/pacman/pkg etc/resolv.conf etc/pacman.d/gnupg \
		run dev sys proc; do
		if mountpoint --quiet "$work/mnt/$m"; then
			umount --recursive "$work/mnt/$m"
		fi
	done
	if mountpoint --quiet "$work/mnt"; then
		umount "$work/mnt"
	fi
	if mountpoint --quiet "$work/lower"; then
		umount "$work/lower"
	fi
	rm --recursive --force "$work"
}

mount_api() {
	local d
	for d in proc sys dev run; do
		mount --rbind "/$d" "$work/mnt/$d"
		mount --make-rslave "$work/mnt/$d"
	done
}

umount_api() {
	local d
	for d in run dev sys proc; do
		umount --recursive "$work/mnt/$d"
	done
}

# Host keyring, resolver, repo indexes and package cache, only while pacman
# runs: finalize deletes /etc/pacman.d/gnupg and empties /var in the tree.
# The indexes are shared with the box's own pacman -Sy.
mount_pacman() {
	local d
	for d in var/lib/pacman/sync var/cache/pacman/pkg; do
		mkdir --parents "/$d" "$work/mnt/$d"
		mount --bind "/$d" "$work/mnt/$d"
	done
	mkdir --parents "$work/mnt/etc/pacman.d/gnupg"
	mount --bind /etc/pacman.d/gnupg "$work/mnt/etc/pacman.d/gnupg"
	# A touch of an existing file would still be copied up.
	[ -e "$work/mnt/etc/resolv.conf" ] || touch "$work/mnt/etc/resolv.conf"
	mount --bind "$(realpath /etc/resolv.conf)" "$work/mnt/etc/resolv.conf"
}

umount_pacman() {
	umount "$work/mnt/var/lib/pacman/sync" "$work/mnt/var/cache/pacman/pkg" \
		"$work/mnt/etc/resolv.conf" "$work/mnt/etc/pacman.d/gnupg"
}

# carry rules (the state script): the tree's /usr/lib/sysimage/<x> on
# /var/lib/<x>, as on the box, so pacman (or another) writes into the
# image's own DB. Unmounted after finalize, which drops the mount points.
carried=()
mount_carried() {
	local verb path rules
	rules="$("/usr/lib/$IMAGE_ID/state")"
	while read -r verb path; do
		[ "$verb" = carry ] || continue
		[ -d "$work/mnt/usr/lib/sysimage/${path#/var/lib/}" ] || continue
		mkdir --parents "$work/mnt$path"
		mount --bind "$work/mnt/usr/lib/sysimage/${path#/var/lib/}" \
			"$work/mnt$path"
		carried+=("${path#/}")
	done <<< "$rules"
}

umount_carried() {
	local m
	for m in "${carried[@]}"; do
		umount "$work/mnt/$m"
	done
	carried=()
}

# The box's /etc/<id> (local state.d rules) for finalize in the tree;
# finalize keeps it out of factory as machine state.
mount_local_config() {
	[ -d "/etc/$IMAGE_ID" ] || return 0
	mkdir --parents "$work/mnt/etc/$IMAGE_ID"
	mount --bind -o ro "/etc/$IMAGE_ID" "$work/mnt/etc/$IMAGE_ID"
}

# overlayfs marks a replaced (or new) dir opaque; mkfs.erofs ignores that
# xattr, so whiteout each lower entry it hides: --ovlfs-strip=1 then deletes
# them like any whiteout.
expand_opaque() {
	local dir rel entry
	getfattr --absolute-names --recursive --physical --no-dereference --dump \
		--match='^trusted\.overlay\.opaque$' "$work/upper" \
		| sed -n 's/^# file: //p' \
		| while IFS= read -r dir; do
			rel="${dir#"$work/upper"}"
			shopt -s dotglob nullglob
			for entry in "$work/lower$rel"/*; do
				entry="$dir/${entry##*/}"
				if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
					mknod "$entry" c 0 0
				fi
			done
			setfattr --remove=trusted.overlay.opaque "$dir"
		done
}

# Image by rename (same filesystem: no copy, extents stay shared), UKI via
# a temporary name so the ESP never holds a partial entry. +3: boot-counting
# tries, systemd-bless-boot drops the counter once the boot is good.
install_next() {
	local uki="/boot/EFI/Linux/${IMAGE_ID}_$version+3.efi"
	chmod 0444 "$next.erofs"
	mv "$next.erofs" "/system/${IMAGE_ID}_$version.erofs"
	cp "$next.efi" "$uki.tmp"
	mv "$uki.tmp" "$uki"
}

# Older than the newest $keep and not running: image and UKI (any counter).
prune() {
	local v
	find /system -maxdepth 1 -name "${IMAGE_ID}_*.erofs" -printf '%f\n' \
		| sed "s/^${IMAGE_ID}_\(.*\)\.erofs$/\1/" | sort | head --lines=-"$keep" \
		| while IFS= read -r v; do
			[ "$v" != "$IMAGE_VERSION" ] || continue
			echo "Pruning $IMAGE_ID $v"
			rm --force "/system/${IMAGE_ID}_$v.erofs" \
				"/boot/EFI/Linux/${IMAGE_ID}_$v.efi" \
				"/boot/EFI/Linux/${IMAGE_ID}_$v+"*.efi
		done
}

squash=false
case "${1:-}" in
glue)
	shift
	fetch_glue "$@"
	exit 0
	;;
-h|--help)
	usage
	exit 0
	;;
--squash)
	squash=true
	shift
	;;
esac

if [ "$#" -eq 0 ]; then
	set -- -Syu
fi

version="$(date --utc +%Y%m%d%H%M%S)"
if [ "$version" -le "$IMAGE_VERSION" ]; then
	echo "Next version $version is not newer than $IMAGE_VERSION" >&2
	exit 1
fi
current="/system/${IMAGE_ID}_${IMAGE_VERSION}.erofs"
next="$work/out/${IMAGE_ID}_$version"

cleanup
trap cleanup EXIT
mkdir --parents "$work"/{lower,upper,work,mnt,out}

# metacopy=off: a metadata-only copy-up has no data to append.
mount -o ro "$current" "$work/lower"
mount -t overlay overlay \
	-o "lowerdir=$work/lower,upperdir=$work/upper,workdir=$work/work,metacopy=off" \
	"$work/mnt"

if [ -d "$state/glue" ]; then
	"$state/glue/scripts/install-glue" "$state/glue" "$work/mnt"
fi

mount_api
mount_pacman
mount_carried
pacman --sysroot "$work/mnt" "$@"
umount_pacman
# Off before finalize: a bound /var/lib/<x> shows content next to its
# sysimage copy, which finalize refuses as a conflict.
umount_carried

chroot "$work/mnt" env IMAGE_VERSION="$version" \
	"/usr/lib/$IMAGE_ID/postinst" /uki.efi
mount_local_config
chroot "$work/mnt" "/usr/lib/$IMAGE_ID/finalize"
if mountpoint --quiet "$work/mnt/etc/$IMAGE_ID"; then
	umount "$work/mnt/etc/$IMAGE_ID"
fi
mv "$work/mnt/uki.efi" "$next.efi"
umount_api

# Full image of the tree in $1. 48bit lets later incremental builds put
# the root inode anywhere: without it its nid is 16 bits, so an appended
# root past nid 65535 must fit the old root's slot or mkfs.erofs fails.
build_full() {
	mkfs.erofs --quiet -zzstd -E48bit "$next.erofs" "$1"
}

if [ "$squash" = true ]; then
	build_full "$work/mnt"
	umount "$work/mnt"
else
	umount "$work/mnt"
	expand_opaque
	cp --reflink=always "$current" "$next.erofs"
	if ! mkfs.erofs --quiet -zzstd --incremental=data --ovlfs-strip=1 \
		"$next.erofs" "$work/upper"; then
		# Typically a grown root dir in an image without 48bit: the
		# full image (48bit) keeps the following deltas clear of it.
		echo "Incremental build failed; building a full image instead" >&2
		rm "$next.erofs"
		# The same merged view, read-only: the upper (whiteouts as
		# expanded above) as top lower layer.
		mount -t overlay overlay \
			-o "lowerdir=$work/upper:$work/lower" "$work/mnt"
		build_full "$work/mnt"
		umount "$work/mnt"
	fi
fi

install_next
prune
# Staged packages are inside the image now; the cache only duplicates them.
find /var/cache/pacman/pkg -mindepth 1 -delete

echo "Staged $IMAGE_ID $version; reboot to switch."
