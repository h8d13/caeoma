#!/bin/bash
# <id>: derive the next image from the newest one and stage it.
#
#   <id> update [--squash] [pacman args]
#                                 default -Syu; e.g. -Syu foo bar;
#                                 -Q: no package change (new initrd/UKI)
#                                 --squash: full image instead of a delta
#   <id> commit [--squash]        the box's changes into a new version:
#                                 its /usr writes and /etc edits (minus
#                                 machine state); no package change
#   <id> discard                  delete staged versions never booted
#   <id> rollback                 back to the previous version at the
#                                 next boot; the running one is pruned
#   <id> glue [url]               fetch a repo tarball (.tar.gz); its
#                                 scripts/ and tree/ go into every
#                                 following image. URL kept in /etc/<id>.
#
# The base is the newest staged version that can still boot, else the
# running one: updates staged before a reboot add up instead of the last
# one silently replacing the others. -S without -u is refused (a partial
# upgrade). commit has no pacman run: the box's writes on the running
# version are the delta, so that version is the base. A full image is
# built once deltas grew the base too much.
# The base erofs (whole tree) is the lower layer of an overlay; pacman
# runs in it like arch-chroot does (host /proc /sys /dev /run, so hooks see
# real hardware); finalize re-freezes the tree. The next erofs is a reflink
# copy of the base with only the upper dir appended (btrfs shares the
# rest), or with --squash (and as fallback when that fails) the whole
# merged view, dropping data that later appends left dead. The image is
# renamed into /system, the UKI copied to the ESP with boot counting; the
# newest $keep versions (plus the running one) stay. Not systemd-sysupdate:
# it writes NOCOW files, which btrfs cannot reflink with, so every image
# would cost its full size.

set -eu

. /usr/lib/os-release
# The glue scripts (state, install-glue, postinst, finalize) take it.
export IMAGE_ID

state="/var/lib/$IMAGE_ID"
glue_url_file="/etc/$IMAGE_ID/glue-url"
# Same mount as /system: FICLONE refuses to reflink across mounts.
work="/system/.$IMAGE_ID-update"
keep=3

usage() {
	sed -n "2,17{s/^# \{0,1\}//;s/<id>/$IMAGE_ID/g;p}" "$0"
}

fetch_glue() {
	local url="${1:-}"
	if [ -z "$url" ]; then
		url="$(cat "$glue_url_file")"
	fi
	mkdir --parents "$(dirname "$glue_url_file")" "$state"
	echo "$url" > "$glue_url_file"

	local tmp
	tmp="$(mktemp --directory)"
	curl --fail --location "$url" \
		| tar --extract --gzip --strip-components=1 --directory "$tmp"
	rm --recursive --force "$state/glue"
	mkdir "$state/glue"
	cp --archive "$tmp/scripts" "$tmp/tree" "$state/glue/"
	rm --recursive --force "$tmp"
	echo "Glue from $url in $state/glue; used by the next update."
}

# Unmounting in reverse mount order; safe to call at any point.
cleanup() {
	local m
	if mountpoint --quiet "$work/mnt/etc"; then
		umount "$work/mnt/etc"
	fi
	for m in "etc/$IMAGE_ID" "${state#/}/initrd" "${carried[@]}" \
		var/lib/pacman/sync \
		var/cache/pacman/pkg etc/resolv.conf etc/pacman.d/gnupg \
		run dev sys proc; do
		if mountpoint --quiet "$work/mnt/$m"; then
			umount --recursive "$work/mnt/$m"
		fi
	done
	if mountpoint --quiet "$work/mnt"; then
		umount "$work/mnt"
	fi
	if mountpoint --quiet "$work/lower"; then
		umount "$work/lower"
	fi
	if [ -d "$work/etc-snap" ]; then
		btrfs subvolume delete "$work/etc-snap"
	fi
	rm --recursive --force "$work"
}

mount_api() {
	local d
	for d in proc sys dev run; do
		mount --rbind "/$d" "$work/mnt/$d"
		mount --make-rslave "$work/mnt/$d"
	done
}

umount_api() {
	local d
	for d in run dev sys proc; do
		umount --recursive "$work/mnt/$d"
	done
}

# Host keyring, resolver, repo indexes and package cache, only while pacman
# runs: finalize deletes /etc/pacman.d/gnupg and empties /var in the tree.
# The indexes are shared with the box's own pacman -Sy.
mount_pacman() {
	local d
	for d in var/lib/pacman/sync var/cache/pacman/pkg; do
		mkdir --parents "/$d" "$work/mnt/$d"
		mount --bind "/$d" "$work/mnt/$d"
	done
	mkdir --parents "$work/mnt/etc/pacman.d/gnupg"
	mount --bind /etc/pacman.d/gnupg "$work/mnt/etc/pacman.d/gnupg"
	# A touch of an existing file would still be copied up.
	[ -e "$work/mnt/etc/resolv.conf" ] || touch "$work/mnt/etc/resolv.conf"
	mount --bind "$(realpath /etc/resolv.conf)" "$work/mnt/etc/resolv.conf"
}

umount_pacman() {
	umount "$work/mnt/var/lib/pacman/sync" "$work/mnt/var/cache/pacman/pkg" \
		"$work/mnt/etc/resolv.conf" "$work/mnt/etc/pacman.d/gnupg"
}

# carry rules (the state script): the tree's /usr/lib/sysimage/<x> on
# /var/lib/<x>, as on the box, so pacman (or another) writes into the
# image's own DB. Unmounted after finalize, which drops the mount points.
carried=()
mount_carried() {
	local verb path rules
	rules="$("/usr/lib/$IMAGE_ID/state")"
	while read -r verb path; do
		[ "$verb" = carry ] || continue
		[ -d "$work/mnt/usr/lib/sysimage/${path#/var/lib/}" ] || continue
		mkdir --parents "$work/mnt$path"
		mount --bind "$work/mnt/usr/lib/sysimage/${path#/var/lib/}" \
			"$work/mnt$path"
		carried+=("${path#/}")
	done <<< "$rules"
}

umount_carried() {
	local m
	for m in "${carried[@]}"; do
		umount "$work/mnt/$m"
	done
	carried=()
}

# The /etc the box boots the next version with, over the tree's /etc
# while postinst builds the initrd (drop-ins, modprobe.d, vconsole.conf,
# FILES+= targets, /etc/kernel/cmdline): the box's upper on the tree's
# /etc, read-only. The upper from a snapshot: it changes under the live
# /etc overlay meanwhile.
mount_box_etc() {
	btrfs subvolume snapshot -r /system/@etc "$work/etc-snap"
	mount -t overlay overlay \
		-o "ro,lowerdir=$work/etc-snap/upper:$work/mnt/etc" "$work/mnt/etc"
}

umount_box_etc() {
	umount "$work/mnt/etc"
	btrfs subvolume delete "$work/etc-snap"
}

# The box's /etc/<id> in the tree, read-only, from pacman to finalize:
# local state.d rules for finalize, which keeps it out of factory as
# machine state.
mount_local_config() {
	[ -d "/etc/$IMAGE_ID" ] || return 0
	mkdir --parents "$work/mnt/etc/$IMAGE_ID"
	mount --bind -o ro "/etc/$IMAGE_ID" "$work/mnt/etc/$IMAGE_ID"
}

# overlayfs marks a replaced (or new) dir opaque; mkfs.erofs ignores that
# xattr, so whiteout each lower entry it hides: --ovlfs-strip=1 then deletes
# them like any whiteout.
expand_opaque() {
	local dir rel entry
	getfattr --absolute-names --recursive --physical --no-dereference --dump \
		--match='^trusted\.overlay\.opaque$' "$work/upper" \
		| sed -n 's/^# file: //p' \
		| while IFS= read -r dir; do
			rel="${dir#"$work/upper"}"
			shopt -s dotglob nullglob
			for entry in "$work/lower$rel"/*; do
				entry="$dir/${entry##*/}"
				if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
					mknod "$entry" c 0 0
				fi
			done
			setfattr --remove=trusted.overlay.opaque "$dir"
		done
}

# The rest of overlayfs' bookkeeping (origin, impure, uuid) means nothing
# inside an image: whiteouts are the only change left to carry.
strip_overlay_xattrs() {
	local line file=""
	getfattr --absolute-names --recursive --physical --no-dereference --dump \
		--match='^trusted\.overlay\.' "$work/upper" \
		| while IFS= read -r line; do
			case "$line" in
			"# file: "*) file="${line#"# file: "}" ;;
			trusted.overlay.*=*)
				setfattr --remove="${line%%=*}" "$file" ;;
			esac
		done
}

# commit: the box's changes as the upper, copied before the overlay mounts
# (an upper changed under a mounted overlay is undefined). The running
# version's /usr upper (sysext), the /etc upper minus machine state: that
# stays the box's, never inside an image (the erofs files are readable by
# all). Through /system: one mount, so reflinked.
take_box_changes() {
	local usr="/system/@var/lib/$IMAGE_ID/usr/$IMAGE_VERSION"
	local verb path entry
	if [ -d "$usr" ]; then
		cp --archive --reflink=auto "$usr" "$work/upper/usr"
	fi
	cp --archive --reflink=auto /system/@etc/upper "$work/upper/etc"
	shopt -s dotglob nullglob
	while read -r verb path; do
		[ "$verb" = machine ] || continue
		for entry in "$work/upper"$path; do
			rm --recursive --force "$entry"
		done
	done <<< "$("/usr/lib/$IMAGE_ID/state")"
	shopt -u dotglob nullglob
}

# Image by rename (same filesystem: no copy, extents stay shared), UKI via
# a temporary name so the ESP never holds a partial entry. +3: boot-counting
# tries, systemd-bless-boot drops the counter once the boot is good.
install_next() {
	local esp="/boot/EFI/Linux/${IMAGE_ID}_$version"
	chmod 0444 "$next.erofs"
	mv "$next.erofs" "/system/${IMAGE_ID}_$version.erofs"
	chattr +i "/system/${IMAGE_ID}_$version.erofs"
	# Fallback first: the main UKI is what makes the version installed.
	# "-" sorts before ".", so sd-boot puts it just under the main UKI.
	cp "$next.fallback.efi" "$esp-fallback+3.efi.tmp"
	mv "$esp-fallback+3.efi.tmp" "$esp-fallback+3.efi"
	cp "$next.efi" "$esp+3.efi.tmp"
	mv "$esp+3.efi.tmp" "$esp+3.efi"
}

versions() {
	find /system -maxdepth 1 -name "${IMAGE_ID}_*.erofs" -printf '%f\n' \
		| sed "s/^${IMAGE_ID}_\(.*\)\.erofs$/\1/" | sort
}

# True when version $1 has a UKI on the ESP (any boot counter).
has_uki() {
	[ -e "/boot/EFI/Linux/${IMAGE_ID}_$1.efi" ] \
		|| compgen -G "/boot/EFI/Linux/${IMAGE_ID}_$1+*.efi" > /dev/null
}

# True when version $1 failed every boot try: only +0-N UKIs, sd-boot
# falls back past them.
is_spent() {
	[ ! -e "/boot/EFI/Linux/${IMAGE_ID}_$1.efi" ] \
		&& compgen -G "/boot/EFI/Linux/${IMAGE_ID}_$1+0-*.efi" > /dev/null \
		&& ! compgen -G "/boot/EFI/Linux/${IMAGE_ID}_$1+[1-9]*.efi" \
			> /dev/null
}

# Newest version above the running one that can still boot, if any.
newest_staged() {
	local v
	versions | while IFS= read -r v; do
		if [ "$v" -gt "$IMAGE_VERSION" ] && has_uki "$v" \
			&& ! is_spent "$v"; then
			echo "$v"
		fi
	done | tail --lines=1
}

# Staged versions (newer than the running one) are what the next update
# builds on: deleting them starts over from the running version.
discard() {
	local v staged
	staged="$(versions | while IFS= read -r v; do
		[ "$v" -le "$IMAGE_VERSION" ] || echo "$v"
	done)"
	if [ -z "$staged" ]; then
		echo "Nothing staged"
		return
	fi
	for v in $staged; do
		echo "Discarding staged $IMAGE_ID $v"
		remove_version "$v"
	done
}

# Back to the newest bootable version below the running one, as boot
# counting would after failed tries: every UKI of the running version
# (main and fallback) spent, so sd-boot passes it and prune deletes it.
# Staged versions go first, they build on the version left behind.
rollback() {
	local v prev f entry
	prev="$(versions | while IFS= read -r v; do
		if [ "$v" -lt "$IMAGE_VERSION" ] && has_uki "$v" \
			&& ! is_spent "$v"; then
			echo "$v"
		fi
	done | tail --lines=1)"
	if [ -z "$prev" ]; then
		echo "No bootable $IMAGE_ID version below $IMAGE_VERSION" >&2
		exit 1
	fi
	discard
	for f in "/boot/EFI/Linux/${IMAGE_ID}_$IMAGE_VERSION"{,-fallback}{,+*}.efi; do
		[ -e "$f" ] || continue
		entry="${f%.efi}"
		entry="${entry%+*}"
		[ "$f" = "$entry+0-3.efi" ] || mv "$f" "$entry+0-3.efi"
	done
	echo "Spent $IMAGE_ID $IMAGE_VERSION; reboot into $prev."
}

# Image (immutable: tmpfiles, install_next; lifted only to delete), UKI
# and /usr upper (the box's writes on top of it) of version $1.
remove_version() {
	chattr -i "/system/${IMAGE_ID}_$1.erofs"
	rm "/system/${IMAGE_ID}_$1.erofs"
	rm --force "/boot/EFI/Linux/${IMAGE_ID}_$1.efi" \
		"/boot/EFI/Linux/${IMAGE_ID}_$1+"*.efi \
		"/boot/EFI/Linux/${IMAGE_ID}_$1-fallback"*.efi
	rm --recursive --force "${state:?}/usr/${1:?}"
}

# Unbootable versions first, they would count towards $keep: leftovers of
# an interrupted install (a UKI copy never renamed, an image whose UKI
# never landed) and versions that spent their boot tries. Then older than
# the newest $keep. Never the running one.
prune() {
	local v
	rm --force "/boot/EFI/Linux/${IMAGE_ID}_"*.efi.tmp
	versions | while IFS= read -r v; do
		[ "$v" != "$IMAGE_VERSION" ] || continue
		if ! has_uki "$v"; then
			echo "Pruning $IMAGE_ID $v (no UKI)"
			remove_version "$v"
		elif is_spent "$v"; then
			echo "Pruning $IMAGE_ID $v (failed every boot try)"
			remove_version "$v"
		fi
	done
	versions | head --lines=-"$keep" \
		| while IFS= read -r v; do
			[ "$v" != "$IMAGE_VERSION" ] || continue
			echo "Pruning $IMAGE_ID $v"
			remove_version "$v"
		done
}

# True when pacman args $@ install packages (-S) without a system upgrade
# (-u): they would be built against indexes newer than the rest. Sync
# queries and cache work install nothing: -Ss -Si -Sl -Sg -Sp -Sc -Sw.
is_partial_sync() {
	local a sync=false upgrade=false query=false
	for a in "$@"; do
		case "$a" in
		--sync) sync=true ;;
		--sysupgrade) upgrade=true ;;
		--search|--info|--list|--groups|--print|--clean|--downloadonly)
			query=true ;;
		--*) ;;
		-*)
			[[ "$a" != *S* ]] || sync=true
			[[ "$a" != *u* ]] || upgrade=true
			[[ "$a" != *[siglpcw]* ]] || query=true
			;;
		esac
	done
	[ "$sync" = true ] && [ "$upgrade" = false ] && [ "$query" = false ]
}

# One run at a time: a second one's cleanup would tear down the first's
# work dir, a glue fetch would swap the glue a run is reading.
lock() {
	exec {lock_fd}> "/run/$IMAGE_ID-update.lock"
	if ! flock --nonblock "$lock_fd"; then
		echo "Another $IMAGE_ID run is going on" >&2
		exit 1
	fi
}

case "${1:-}" in
glue)
	shift
	lock
	fetch_glue "$@"
	exit 0
	;;
discard)
	lock
	discard
	exit 0
	;;
rollback)
	lock
	rollback
	exit 0
	;;
-h|--help)
	usage
	exit 0
	;;
update)
	commit=false
	shift
	;;
commit)
	commit=true
	shift
	;;
*)
	usage >&2
	exit 2
	;;
esac
squash=false
if [ "${1:-}" = --squash ]; then
	squash=true
	shift
fi

if [ "$commit" = true ] && [ "$#" -gt 0 ]; then
	usage >&2
	exit 2
fi
if [ "$#" -eq 0 ]; then
	set -- -Syu
fi
if is_partial_sync "$@"; then
	echo "-S without -u stages a partial upgrade (the repo indexes are" \
		"shared with the box's pacman -Sy); use -Syu <packages>" >&2
	exit 2
fi
lock

base="$IMAGE_VERSION"
staged="$(newest_staged)"
if [ "$commit" = true ] && [ -n "$staged" ]; then
	echo "commit builds on the running $IMAGE_ID $IMAGE_VERSION, which" \
		"would leave staged $staged behind: boot it first, or" \
		"$IMAGE_ID discard" >&2
	exit 1
fi
if [ -n "$staged" ]; then
	base="$staged"
	echo "Building on staged $IMAGE_ID $base (not booted yet;" \
		"$IMAGE_ID discard starts over)"
fi
version="$(date --utc +%Y%m%d%H%M%S)"
if [ "$version" -le "$base" ]; then
	echo "Next version $version is not newer than $base" >&2
	exit 1
fi
current="/system/${IMAGE_ID}_${base}.erofs"

next="$work/out/${IMAGE_ID}_$version"

cleanup
trap cleanup EXIT

# Seconds per phase, for the closing line.
timings=""
lap="$EPOCHREALTIME"
phase() {
	local now="$EPOCHREALTIME"
	timings+=" $1 $(awk -v a="$lap" -v b="$now" \
		'BEGIN { printf "%.1fs", b - a }')"
	lap="$now"
}

mkdir --parents "$work"/{lower,upper,work,mnt,out}

# The upper must hold everything that changed: metacopy=off, a
# metadata-only copy-up has no data to append; redirect_dir=off, a renamed
# dir is copied up whole instead of pointing at its lower name.
mount -o ro "$current" "$work/lower"
# mkfs.erofs takes the root inode from the upper (or merged) dir: keep the
# image's, not mkdir's.
chmod --reference="$work/lower" "$work/upper"
chown --reference="$work/lower" "$work/upper"
if [ "$commit" = true ]; then
	take_box_changes
fi
mount -t overlay overlay \
	-o "lowerdir=$work/lower,upperdir=$work/upper,workdir=$work/work" \
	-o metacopy=off,redirect_dir=off \
	"$work/mnt"

if [ -d "$state/glue" ]; then
	"$state/glue/scripts/install-glue" "$state/glue" "$work/mnt"
fi

# Deltas keep the data they replace, dead but inside every later image: a
# full image once the base outgrew the last full one of its line by
# $growth percent (/etc/<id>/squash-growth). Each image carries that size
# (/usr/lib/<id>/full-size); a full image none: its own size is the
# reference, written into the next one.
full_size_file="$work/mnt/usr/lib/$IMAGE_ID/full-size"
growth=50
[ ! -f "/etc/$IMAGE_ID/squash-growth" ] \
	|| growth="$(cat "/etc/$IMAGE_ID/squash-growth")"
size="$(stat --format=%s "$current")"
full_size="$size"
[ ! -f "$full_size_file" ] || full_size="$(cat "$full_size_file")"
if [ "$squash" = false ] \
	&& [ $((size * 100)) -gt $((full_size * (100 + growth))) ]; then
	echo "Image grew from $full_size to $size bytes since the last full" \
		"one (over $growth%): building a full image"
	squash=true
fi
if [ "$squash" = true ]; then
	rm --force "$full_size_file"
elif [ ! -f "$full_size_file" ]; then
	echo "$size" > "$full_size_file"
fi
phase setup

mount_api
mount_pacman
mount_carried
mount_local_config
# --root, not --sysroot: the box's own pacman.conf (repos, mirrors, its
# Includes as the box resolves them), the one its pacman -Sy filled the
# shared indexes with. Scriptlets and the tree's hooks still run chrooted
# in the tree, the package DB is the tree's (default DBPath under root).
# Hook dirs (else only the box's, from its pacman.conf): the tree's /etc
# ones as this update's glue rendered them, then the box's, which win.
if [ "$commit" = false ]; then
	pacman --root "$work/mnt" --hookdir "$work/mnt/etc/pacman.d/hooks" \
		--hookdir /etc/pacman.d/hooks "$@"
	phase pacman
fi

# The box's initrd cache for build-uki, which asks pacman what its initrd
# is made of: pacman's binds stay until then, as during the transaction.
mkdir --parents "$state/initrd" "$work/mnt$state/initrd"
mount --bind "$state/initrd" "$work/mnt$state/initrd"
if [ -e /system/@etc/upper/mkinitcpio.conf ]; then
	echo "Edits to /etc/mkinitcpio.conf are not used (the image composes" \
		"its own): move them to /etc/mkinitcpio.conf.d/*.conf" >&2
fi
mount_box_etc
chroot "$work/mnt" env IMAGE_VERSION="$version" INITRD_CACHE="$state/initrd" \
	INITRD_AUTODETECT=1 "/usr/lib/$IMAGE_ID/postinst" /uki.efi
umount_box_etc
umount "$work/mnt$state/initrd"
umount_pacman
# Off before finalize: a bound /var/lib/<x> shows content next to its
# sysimage copy, which finalize refuses as a conflict.
umount_carried
phase postinst

chroot "$work/mnt" "/usr/lib/$IMAGE_ID/finalize"
if mountpoint --quiet "$work/mnt/etc/$IMAGE_ID"; then
	umount "$work/mnt/etc/$IMAGE_ID"
fi
mv "$work/mnt/uki.efi" "$next.efi"
mv "$work/mnt/uki.fallback.efi" "$next.fallback.efi"
umount_api
phase finalize

# Full image of the tree in $1. 48bit lets later incremental builds put
# the root inode anywhere: without it its nid is 16 bits, so an appended
# root past nid 65535 must fit the old root's slot or mkfs.erofs fails.
build_full() {
	mkfs.erofs --quiet -zzstd -E48bit "$next.erofs" "$1"
}

if [ "$squash" = true ]; then
	build_full "$work/mnt"
	umount "$work/mnt"
else
	umount "$work/mnt"
	expand_opaque
	strip_overlay_xattrs
	cp --reflink=always "$current" "$next.erofs"
	if ! mkfs.erofs --quiet -zzstd --incremental=data --ovlfs-strip=1 \
		"$next.erofs" "$work/upper"; then
		# Typically a grown root dir in an image without 48bit: the
		# full image (48bit) keeps the following deltas clear of it.
		echo "Incremental build failed; building a full image instead" >&2
		rm "$next.erofs"
		squash=true
		# A full image carries no reference: whiteout its copy.
		rm --force "$work/upper/usr/lib/$IMAGE_ID/full-size"
		mkdir --parents "$work/upper/usr/lib/$IMAGE_ID"
		mknod "$work/upper/usr/lib/$IMAGE_ID/full-size" c 0 0
		# The same merged view, read-only: the upper (whiteouts as
		# expanded above) as top lower layer.
		mount -t overlay overlay \
			-o "lowerdir=$work/upper:$work/lower" "$work/mnt"
		build_full "$work/mnt"
		umount "$work/mnt"
	fi
fi
phase erofs

install_next
prune
# Staged packages are inside the image now; the cache only duplicates them.
find /var/cache/pacman/pkg -mindepth 1 -delete
phase install

echo "Staged $IMAGE_ID $version; reboot to switch."
# The box's /usr writes stay with the version they were made on. Taken by
# a commit, they leave it: the overlay keeps writing to the renamed upper
# (it holds the dir, not the path), the next boot deletes it, so a
# rollback finds the running version clean.
if [ "$commit" = true ]; then
	if [ -d "$state/usr/$IMAGE_VERSION" ]; then
		mv "$state/usr/$IMAGE_VERSION" \
			"$state/usr/$IMAGE_VERSION.committed"
	fi
	echo "Further /usr writes before the reboot are dropped."
elif [ -d "$state/usr/$IMAGE_VERSION" ] \
	&& [ -n "$(ls -A "$state/usr/$IMAGE_VERSION")" ]; then
	echo "/usr writes on $IMAGE_ID $IMAGE_VERSION are not in $version:" \
		"$IMAGE_ID commit takes them."
fi
echo "Timings:$timings"
