#!/bin/sh
# The glue's finalize (see mkosi.postinst.chroot), then this
# build's UKI into the factory ESP that mkosi.repart turns into esp.raw.
# +3: boot-counting tries until blessed.

set -e

"/usr/lib/$IMAGE_ID/finalize"
cp "$OUTPUTDIR/${IMAGE_ID}_${IMAGE_VERSION}.efi" \
	"/usr/share/factory/boot/EFI/Linux/${IMAGE_ID}_${IMAGE_VERSION}+3.efi"
