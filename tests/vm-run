#!/bin/bash
# Run one test of tests/ inside the last build, in a throwaway VM, and print
# its TAP output. For prove:
#
#	prove --exec tests/vm-run tests/t[1-9]*.sh
#	tests/vm-run tests/t1000-update-delta.sh  # one test, full log kept
#
# The test runs as root from a unit injected as a credential
# (systemd.extra-unit.*), with tests/ mounted at /root/tests. The whole console
# log goes to /tmp/<ImageId>-<test>-<time>.log.

set -eu

cd "$(dirname "$0")/.."

name="$(basename "${1:?usage: tests/vm-run tests/tNNNN-name.sh}" .sh)"
if [ ! -x "tests/$name.sh" ]; then
	echo "Bail out! no executable tests/$name.sh"
	exit 1
fi
id="$(mkosi --json summary | jq --raw-output '.Images[0].ImageId')"
log="/tmp/$id-$name-$(date +%Y%m%d-%H%M%S).log"

creds="$(mktemp --directory)"
trap 'rm --recursive --force "$creds"' EXIT

# Ordered after the network and the keyring so tests can use pacman.
cat > "$creds/systemd.extra-unit.$id-test.service" <<- EOF
	[Unit]
	Description=$id test: $name
	Wants=systemd-networkd-wait-online.service
	After=multi-user.target systemd-networkd-wait-online.service
	After=$id-pacman-init.service systemd-bless-boot.service
	FailureAction=poweroff

	[Service]
	Type=oneshot
	TimeoutStartSec=infinity
	StandardOutput=journal+console
	StandardError=journal+console
	Environment=TEST_STATE=/var/lib/$id-test/$name
	Environment=IMAGE_ID=$id TEST_VM=1
	ExecStart=/root/tests/$name.sh
EOF

timeout 3600 mkosi \
	--machine="$id-test" \
	--credential="$creds/systemd.extra-unit.$id-test.service" \
	--kernel-command-line-extra="systemd.wants=$id-test.service" \
	--runtime-tree="$PWD/tests:/root/tests" \
	--ram=4G --cpus=4 \
	--console=read-only \
	--ephemeral=yes \
	vm > "$log" 2>&1 || true

echo "# log: $log"
# The test's own lines, without the journal prefix.
grep "$name\.sh\[" "$log" | sed "s/^.*$name\.sh\[[0-9]*\]: //" || true
if ! grep --quiet "$name\.sh\[[0-9]*\]: # test_done" "$log"; then
	echo "Bail out! $name did not reach test_done"
	exit 1
fi
