#!/bin/bash
# Run one test of t/ inside the last build, in a throwaway VM, and print
# its TAP output. For prove:
#
#	prove --exec t/vm-run t/t[0-9]*.sh
#	t/vm-run t/t1000-update-delta.sh        # one test, full log kept
#
# The test runs as root from a unit injected as a credential
# (systemd.extra-unit.*), with t/ mounted at /root/t. The whole console
# log goes to /tmp/caeoma-<test>-<time>.log.

set -eu

cd "$(dirname "$0")/.."

name="$(basename "${1:?usage: t/vm-run t/tNNNN-name.sh}" .sh)"
if [ ! -x "t/$name.sh" ]; then
	echo "Bail out! no executable t/$name.sh"
	exit 1
fi
log="/tmp/caeoma-$name-$(date +%Y%m%d-%H%M%S).log"

creds="$(mktemp --directory)"
trap 'rm --recursive --force "$creds"' EXIT

# Ordered after the network and the keyring so tests can use pacman.
cat > "$creds/systemd.extra-unit.caeoma-test.service" <<- EOF
	[Unit]
	Description=caeoma test: $name
	Wants=systemd-networkd-wait-online.service
	After=multi-user.target systemd-networkd-wait-online.service
	After=caeoma-pacman-init.service systemd-bless-boot.service
	FailureAction=poweroff

	[Service]
	Type=oneshot
	TimeoutStartSec=infinity
	StandardOutput=journal+console
	StandardError=journal+console
	Environment=TEST_STATE=/var/lib/caeoma-test/$name
	ExecStart=/root/t/$name.sh
EOF

timeout 3600 mkosi \
	--machine=caeoma-test \
	--credential="$creds/systemd.extra-unit.caeoma-test.service" \
	--kernel-command-line-extra="systemd.wants=caeoma-test.service" \
	--runtime-tree="$PWD/t:/root/t" \
	--ram=4G --cpus=4 \
	--console=read-only \
	--ephemeral=yes \
	vm > "$log" 2>&1 || true

echo "# log: $log"
# The test's own lines, without the journal prefix.
grep "$name\.sh\[" "$log" | sed "s/^.*$name\.sh\[[0-9]*\]: //" || true
if ! grep --quiet "$name\.sh\[[0-9]*\]: # test_done" "$log"; then
	echo "Bail out! $name did not reach test_done"
	exit 1
fi
