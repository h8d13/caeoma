# Per-machine knobs. Copy to mkosi.local.conf (gitignored) and adjust.
# mkosi layers it over mkosi.conf; list settings (Packages=, ...) append.
# Then build: mkosi -B -f build. Installed boxes update with <ImageId>-update.

[Distribution]
# Build mirror, also written into the image's pacman mirrorlist.
# Default: geo.mirror.pkgbuild.com.
#Mirror=https://mirror.example.org/archlinux
# Deterministic builds: the same packages every time, from a dated Arch
# Linux Archive snapshot (archive.archlinux.org when Mirror= is unset;
# `mkosi latest-snapshot` names the newest). Only the build is pinned:
# the image's mirrorlist keeps Mirror= (or the default), so boxes update
# from live repos. A Mirror= pointing into the archive would freeze them.
#Snapshot=2026/10/01

[Content]
# First boot settings, over mkosi.conf's (applied on the box, no prompt).
# A hashed password: hashed: + the output of openssl passwd -6.
#RootPassword=hashed:$6$...
#Locale=en_US.UTF-8
#Keymap=fr
#Timezone=Europe/Paris

# Extra packages baked into the image. Example:
#Packages=
#	linux-firmware
#	iwd
#	openssh
#	nano

# Appended to the UKI kernel command line.
#KernelCommandLine=
#	console=ttyS0
#	quiet

[Runtime]
# `mkosi vm` only.
#RAM=4G
#CPUs=4
#RuntimeSize=32G
