#!/bin/bash
# Initrd pieces to mount the versioned erofs /usr (see the usr generator).

build() {
	add_binary /usr/lib/systemd/system-generators/__NAME__-usr-generator
	# The generator reads the ESP's id from an EFI variable with these
	# (busybox here lacks them).
	map add_binary tail tr
	# etc-dedup, run before the /etc overlay mounts, and what it uses that
	# the initrd lacks (busybox here has neither find nor cmp). Its
	# interpreter first: add_binary checks a script's is already there.
	map add_binary bash getfattr find cmp
	add_binary /usr/lib/__NAME__/etc-dedup

	# grow-root and the btrfs resize after it (see the usr generator);
	# systemd-repart loads libfdisk at run time, add_binary misses it.
	map add_binary systemd-repart btrfs /usr/lib/libfdisk.so.1
	add_binary /usr/lib/__NAME__/grow-root
	add_file /usr/lib/__NAME__/repart.d/10-root.conf

	# Needed for /dev/gpt-auto-root to show up.
	map add_udev_rule 90-image-dissect.rules 99-systemd.rules
}

help() {
	echo "Mount this image's versioned erofs as /usr."
}
