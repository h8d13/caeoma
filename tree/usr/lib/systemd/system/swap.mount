# /swap is the @swap subvolume of the root partition (install.repart): the
# swapfile only, out of the other subvolumes' snapshots. Encrypted with the
# root when that is LUKS2.

[Unit]
Before=local-fs.target

[Mount]
What=/dev/gpt-auto-root
Where=/swap
Type=btrfs
Options=subvol=/@swap,nodev,noexec
