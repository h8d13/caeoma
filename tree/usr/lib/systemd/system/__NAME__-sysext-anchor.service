# systemd-sysext runs before systemd-tmpfiles-setup, so its anchor
# extension and the version's upper (the sysext tmpfiles entry) are
# created here, just ahead of it.

[Unit]
Description=Anchor extension and upper for the writable /usr
DefaultDependencies=no
RequiresMountsFor=/var/lib
Before=systemd-sysext.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=systemd-tmpfiles --create __NAME__-sysext.conf

[Install]
WantedBy=systemd-sysext.service
