#!/bin/bash
# carry rules (/usr/lib/__NAME__/state): bind /usr/lib/sysimage/<x> back to
# /var/lib/<x>, as NixOS impermanence generates its bind mounts. A bind,
# not a symlink: libalpm replaces a symlinked local/ with a directory of
# only its new entries. After the sysext /usr is merged, so live writes
# (pacman -S on the box) land in the version's upper with the files.

set -eu

[ "${SYSTEMD_IN_INITRD:-0}" = 1 ] && exit 0

out="$1"
rules="$(IMAGE_ID=__NAME__ /usr/lib/__NAME__/state)"

while read -r verb path; do
	[ "$verb" = carry ] || continue
	unit="$(systemd-escape --path --suffix=mount "$path")"
	cat > "$out/$unit" <<- EOF
		# Generated by $(basename "$0") from: carry $path
		[Unit]
		DefaultDependencies=no
		RequiresMountsFor=/var
		After=systemd-sysext.service
		Before=sysinit.target umount.target
		Conflicts=umount.target

		[Mount]
		What=/usr/lib/sysimage/${path#/var/lib/}
		Where=$path
		Type=none
		Options=bind
	EOF
	mkdir --parents "$out/sysinit.target.wants"
	ln --symbolic --force "../$unit" "$out/sysinit.target.wants/$unit"
done <<< "$rules"
