#!/bin/sh
# Initrd only. Mount stack for the root partition (found by gpt-auto):
#   btrfs top level                          -> /sysroot/system
#   /sysroot/system/<id>_<ver>.erofs (usr/)  -> /sysusr/usr -> /sysroot/usr
#   overlay: /sysroot/usr/share/factory/etc  -> /sysroot/etc
#            (lower) under @etc/upper (local changes, persistent),
#            after etc-dedup drops what the image ships alike
# <id>/<ver> come from the initrd's os-release, so each UKI boots its /usr.

set -eu

[ "${SYSTEMD_IN_INITRD:-0}" = 1 ] || exit 0

. /usr/lib/os-release

normal_dir=$1

# A counted boot (sd-boot sets LoaderBootCountPath) whose image does not
# mount reboots: the entry spends its tries, sd-boot falls back to an older
# one. A blessed entry gets the emergency shell instead: its fault is not
# this version's, rebooting would only loop.
loader_guid=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
failure=""
if [ -e "/sys/firmware/efi/efivars/LoaderBootCountPath-$loader_guid" ]; then
	failure="FailureAction=reboot-force"
fi

cat > "$normal_dir/sysroot-system.mount" <<- EOF
	# Generated by $(basename "$0")
	[Unit]
	Before=initrd-fs.target
	After=sysroot.mount
	After=blockdev@dev-gpt\x2dauto\x2droot.target

	[Mount]
	What=/dev/gpt-auto-root
	Where=/sysroot/system
	Options=rw,nodev,subvol=/,compress=zstd
	DirectoryMode=0700
EOF

cat > "$normal_dir/sysusr-usr.mount" <<- EOF
	# Generated by $(basename "$0")
	[Unit]
	Before=initrd-usr-fs.target
	RequiresMountsFor=/sysroot/system
	$failure

	[Mount]
	What=/sysroot/system/${IMAGE_ID}_${IMAGE_VERSION}.erofs
	Where=/sysusr/usr
	Type=erofs
	Options=ro,X-mount.subdir=usr
EOF

cat > "$normal_dir/sysroot-usr.mount" <<- EOF
	# Generated by $(basename "$0")
	[Unit]
	Before=initrd-usr-fs.target
	After=sysusr-usr.mount

	[Mount]
	What=/sysusr/usr
	Where=/sysroot/usr
	Options=bind
EOF

# Every image brings its own lower: untouched files follow the image, an
# edit or delete is copied up and kept. A lower swapped between mounts is
# only safe with index, metacopy and redirect_dir off. Before
# initrd-parse-etc, which reads /sysroot/etc/fstab.
etc_lower=/sysroot/usr/share/factory/etc
etc_upper=/sysroot/system/@etc
etc_opts="lowerdir=$etc_lower,upperdir=$etc_upper/upper"
etc_opts="$etc_opts,workdir=$etc_upper/work,index=off,metacopy=off"
etc_opts="$etc_opts,redirect_dir=off"
# The upper only changes unmounted. Failure only skips it (-): the copies
# keep shadowing, as without it, and the next boot tries again.
cat > "$normal_dir/$IMAGE_ID-etc-dedup.service" <<- EOF
	# Generated by $(basename "$0")
	[Unit]
	DefaultDependencies=no
	RequiresMountsFor=$etc_upper $etc_lower

	# Once: the initrd's daemon-reload must not run it again, the upper
	# then being mounted.
	[Service]
	Type=oneshot
	RemainAfterExit=yes
	ExecStart=-/usr/lib/$IMAGE_ID/etc-dedup /sysroot $IMAGE_ID $IMAGE_VERSION
EOF

cat > "$normal_dir/sysroot-etc.mount" <<- EOF
	# Generated by $(basename "$0")
	[Unit]
	Before=initrd-fs.target initrd-parse-etc.service
	RequiresMountsFor=$etc_upper $etc_lower
	Wants=$IMAGE_ID-etc-dedup.service
	After=$IMAGE_ID-etc-dedup.service
	$failure

	[Mount]
	What=overlay
	Where=/sysroot/etc
	Type=overlay
	Options=$etc_opts
EOF

mkdir -p "$normal_dir/initrd-usr-fs.target.requires" \
	"$normal_dir/initrd-fs.target.requires"
ln -s ../sysusr-usr.mount "$normal_dir/initrd-usr-fs.target.requires/"
ln -s ../sysroot-system.mount "$normal_dir/initrd-fs.target.requires/"
ln -s ../sysroot-usr.mount "$normal_dir/initrd-fs.target.requires/"
ln -s ../sysroot-etc.mount "$normal_dir/initrd-fs.target.requires/"
